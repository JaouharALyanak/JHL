# Configuration Apache - URL Rewriting
RewriteEngine On

# ============================================
# 1. FORCER HTTPS + WWW (SEO critique)
# ============================================
# Non-HTTPS → HTTPS (avec ou sans www)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# non-www → www (après HTTPS forcé)
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ============================================
# 2. REDIRECTION POST /contact → contact.php
# ============================================
RewriteCond %{REQUEST_METHOD} POST
RewriteRule ^contact$ /contact.php [L,QSA]

# ============================================
# 3. EXCLURE LES FICHIERS .PHP
# ============================================
RewriteCond %{REQUEST_URI} \.php$ [NC]
RewriteRule .* - [L]

# ============================================
# 4. REDIRECTIONS 301 URLS PROPRES (SEO)
# ============================================
# /index.html → /
RewriteCond %{THE_REQUEST} ^GET\ /index\.html\ HTTP
RewriteRule ^index\.html$ / [R=301,L]

# /dossier/index.html → /dossier/
RewriteCond %{THE_REQUEST} ^GET\ /(.+)/index\.html\ HTTP
RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]

# /page.html → /page
RewriteCond %{THE_REQUEST} ^GET\ /(.*)\.html\ HTTP
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# ============================================
# 5. RÉÉCRITURE INTERNE → fichiers .html
# ============================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# ============================================
# 6. PARAMÈTRES SERVEUR
# ============================================
DirectoryIndex index.html
Options -Indexes

# ============================================
# 7. COMPRESSION GZIP
# ============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
    text/javascript application/javascript application/x-javascript \
    application/json image/svg+xml
</IfModule>

# ============================================
# 8. CACHE NAVIGATEUR
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>